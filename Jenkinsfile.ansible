pipeline {
    agent any

    environment {
        APPLICATION_NAME = 'pet-adoption'
        NEXUS_REGISTRY   = 'registry.ferdeve.fit'
        NEXUS_REPOSITORY = 'pet-adoption-docker'
        AWS_REGION       = 'eu-west-3'
        NEXUS_USERNAME      = 'nexus-ci-writer'
        NEXUS_PARAMETER     = '/devops-platform/nexus/ci-writer-password'
        DEPLOY_ENVIRONMENT  = 'stage'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG =
                        "build-${BUILD_NUMBER}-${env.GIT_SHORT_SHA}"

                    env.NEXUS_IMAGE =
                        "${NEXUS_REGISTRY}/${NEXUS_REPOSITORY}:${IMAGE_TAG}"
                }

                echo "Image tag: ${IMAGE_TAG}"
            }
        }

        stage('Build and Test') {
            steps {
                sh './mvnw clean verify'
            }
        }

        stage('Verify Artifact') {
            steps {
                sh '''
                    test -f target/spring-petclinic-2.4.2.war
                    echo "PASS: WAR artifact exists"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${APPLICATION_NAME}:${IMAGE_TAG} \
                      .
                '''
            }
        }

        stage('Authenticate to Nexus') {
            steps {
                sh '''
                    set +x

                    NEXUS_PASSWORD=$(aws ssm get-parameter \
                      --name "${NEXUS_PARAMETER}" \
                      --with-decryption \
                      --region "${AWS_REGION}" \
                      --query Parameter.Value \
                      --output text)

                    printf '%s' "${NEXUS_PASSWORD}" | \
                      docker login \
                        "${NEXUS_REGISTRY}" \
                        --username "${NEXUS_USERNAME}" \
                        --password-stdin

                    unset NEXUS_PASSWORD
                '''
            }
        }

        stage('Push Image to Nexus') {
            steps {
                sh '''
                    docker tag \
                      ${APPLICATION_NAME}:${IMAGE_TAG} \
                      ${NEXUS_IMAGE}

                    docker push ${NEXUS_IMAGE}
                '''
            }
        }

        stage('Verify Nexus Image') {
            steps {
                sh '''
                    set +x

                    NEXUS_PASSWORD=$(aws ssm get-parameter \
                      --name "${NEXUS_PARAMETER}" \
                      --with-decryption \
                      --region "${AWS_REGION}" \
                      --query Parameter.Value \
                      --output text)

                    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
                      -u "${NEXUS_USERNAME}:${NEXUS_PASSWORD}" \
                      -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                      "https://${NEXUS_REGISTRY}/v2/${NEXUS_REPOSITORY}/manifests/${IMAGE_TAG}")

                    unset NEXUS_PASSWORD

                    echo "Nexus manifest response: HTTP=${HTTP_CODE}"
                    test "${HTTP_CODE}" = "200"

                    echo "PASS: ${NEXUS_IMAGE} exists in Nexus"
                '''
            }
        }

        stage('Deploy to Stage via Ansible') {
            steps {
                sh '''
                    set -eu

                    echo "Triggering deployment:"
                    echo "  Environment: ${DEPLOY_ENVIRONMENT}"
                    echo "  Image tag:   ${IMAGE_TAG}"

                    echo "Discovering running Ansible controller by AWS tags"

                    ANSIBLE_INSTANCE_IDS=$(aws ec2 describe-instances \
                      --region "${AWS_REGION}" \
                      --filters \
                        "Name=tag:Project,Values=ansible-devops-platform" \
                        "Name=tag:Role,Values=ansible" \
                        "Name=tag:Environment,Values=management" \
                        "Name=instance-state-name,Values=running" \
                      --query 'Reservations[].Instances[].InstanceId' \
                      --output text)

                    CONTROLLER_COUNT=$(printf '%s\n' "${ANSIBLE_INSTANCE_IDS}" | awk 'NF {count += NF} END {print count+0}')

                    echo "Matching Ansible controllers: ${CONTROLLER_COUNT}"

                    if [ "${CONTROLLER_COUNT}" -ne 1 ]; then
                        echo "FAIL: expected exactly one running Ansible controller, found ${CONTROLLER_COUNT}"
                        echo "Matches: ${ANSIBLE_INSTANCE_IDS:-none}"
                        exit 1
                    fi

                    ANSIBLE_INSTANCE_ID="${ANSIBLE_INSTANCE_IDS}"

                    echo "Discovered Ansible controller: ${ANSIBLE_INSTANCE_ID}"

                    cat > /tmp/ansible-deploy-commands.json <<EOF
{
  "commands": [
    "set -e",
    "sudo -iu ubuntu git -C /opt/ansible/repo fetch origin",
    "sudo -iu ubuntu git -C /opt/ansible/repo reset --hard origin/main",
    "sudo -iu ubuntu ansible-playbook /opt/ansible/repo/module/ansible/playbooks/deploy.yml -e target_env=${DEPLOY_ENVIRONMENT} -e app_image_tag=${IMAGE_TAG}"
  ]
}
EOF

                    echo "Submitting deployment command to Ansible controller"

                    COMMAND_ID=$(aws ssm send-command \
                      --instance-ids "${ANSIBLE_INSTANCE_ID}" \
                      --document-name "AWS-RunShellScript" \
                      --parameters file:///tmp/ansible-deploy-commands.json \
                      --region "${AWS_REGION}" \
                      --query 'Command.CommandId' \
                      --output text)

                    echo "Ansible SSM command: ${COMMAND_ID}"

                    test -n "${COMMAND_ID}"
                    test "${COMMAND_ID}" != "None"

                    set +e
                    aws ssm wait command-executed \
                      --command-id "${COMMAND_ID}" \
                      --instance-id "${ANSIBLE_INSTANCE_ID}" \
                      --region "${AWS_REGION}"
                    WAIT_RC=$?
                    set -e

                    STATUS=$(aws ssm get-command-invocation \
                      --command-id "${COMMAND_ID}" \
                      --instance-id "${ANSIBLE_INSTANCE_ID}" \
                      --region "${AWS_REGION}" \
                      --query 'Status' \
                      --output text)

                    echo "Deployment command status: ${STATUS}"
                    echo "SSM waiter exit code: ${WAIT_RC}"

                    echo "=== ANSIBLE DEPLOYMENT OUTPUT ==="

                    aws ssm get-command-invocation \
                      --command-id "${COMMAND_ID}" \
                      --instance-id "${ANSIBLE_INSTANCE_ID}" \
                      --region "${AWS_REGION}" \
                      --query 'StandardOutputContent' \
                      --output text

                    if [ "${STATUS}" != "Success" ]; then
                        echo "=== ANSIBLE DEPLOYMENT ERROR ==="

                        aws ssm get-command-invocation \
                          --command-id "${COMMAND_ID}" \
                          --instance-id "${ANSIBLE_INSTANCE_ID}" \
                          --region "${AWS_REGION}" \
                          --query 'StandardErrorContent' \
                          --output text

                        exit 1
                    fi

                    echo "PASS: ${NEXUS_IMAGE} deployed to ${DEPLOY_ENVIRONMENT}"
                '''
            }
        }

    }

    post {
        success {
            echo "Pipeline succeeded."
            echo "Nexus image: ${NEXUS_IMAGE}"
        }

        failure {
            echo "Pipeline failed. Review the failed stage."
        }

        always {
            sh '''
                docker logout ${NEXUS_REGISTRY} >/dev/null 2>&1 || true
            '''
        }
    }
}
